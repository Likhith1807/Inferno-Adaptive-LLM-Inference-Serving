# ==============================================================================
# Inferno: Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or cloud environment.
# Never commit .env files containing real secrets or credentials to source control.

# ------------------------------------------------------------------------------
# Toolchain & Runtime Paths
# ------------------------------------------------------------------------------
# Name of the micromamba / conda toolchain environment (default: inferno-hpc)
INFERNO_TOOLCHAIN_ENV=inferno-hpc

# Path to python virtual environment (default: $HOME/.venvs/inferno)
INFERNO_VENV=~/.venvs/inferno

# Path to compiled CUDA int4 kernel shared library
# INFERNO_INT4_LIB=src/inferno/kernels/libinferno_int4.so

# CUDA Toolkit installation directory
# CUDA_HOME=/usr/local/cuda

# ------------------------------------------------------------------------------
# Model Hub & Hugging Face (Optional)
# ------------------------------------------------------------------------------
# Hugging Face token for downloading gated checkpoints (e.g. Llama models)
HF_TOKEN=hf_your_huggingface_token_here

# ------------------------------------------------------------------------------
# Cloud Infrastructure (AWS - Optional for multi-GPU phase)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# Engine & Execution Flags
# ------------------------------------------------------------------------------
# Set to 0 to keep vLLM engine core in-process for custom kernel patching
VLLM_ENABLE_V1_MULTIPROCESSING=0
